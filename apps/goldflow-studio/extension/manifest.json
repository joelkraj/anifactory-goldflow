{
  "manifest_version": 3,
  "name": "Goldflow Studio Worker",
  "version": "0.1.0",
  "description": "Audited ChatGPT web planning and image transport for AniFactory Goldflow.",
  "permissions": [
    "alarms",
    "downloads",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Goldflow Studio"
  }
}
