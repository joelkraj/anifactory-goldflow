{
  "name": "anifactory-goldflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "goldflow": "./bin/goldflow.mjs"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/generate-workflow-guidance.mjs --check",
    "studio:desktop": "node apps/goldflow-studio/desktop/main.mjs",
    "studio:flow": "node apps/goldflow-studio/desktop/main.mjs --provider google-flow --types image --concurrency 1",
    "studio:hybrid": "node apps/goldflow-studio/desktop/hybrid-main.mjs",
    "studio:login": "node apps/goldflow-studio/desktop/login.mjs",
    "studio:worker": "node apps/goldflow-studio/desktop/connect.mjs",
    "test:studio": "node apps/goldflow-studio/tests/run-tests.mjs && node apps/goldflow-studio/tests/chatgpt-long-context-browser.test.mjs && node apps/goldflow-studio/tests/google-gemini-browser.test.mjs",
    "status": "git status --short",
    "test:stage-contract": "node scripts/tests/stage-contract-tests.mjs",
    "test:planner": "node scripts/tests/planner-tests.mjs",
    "test:voice-boundary": "node scripts/tests/voice-direction-boundary-tests.mjs",
    "test:media": "node scripts/tests/media-tests.mjs",
    "test:reference-parallax": "node scripts/tests/reference-parallax-policy-tests.mjs",
    "test:production-direction": "node scripts/tests/production-direction-tests.mjs",
    "test:integration": "node scripts/tests/integration-tests.mjs",
    "test:fixtures": "npm run test:stage-contract && npm run test:planner && npm run test:voice-boundary && npm run test:media && npm run test:production-direction && npm run test:integration",
    "docs:workflow": "node scripts/generate-workflow-guidance.mjs",
    "docs:workflow:check": "node scripts/generate-workflow-guidance.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.62.1",
    "sharp": "0.35.0"
  }
}
